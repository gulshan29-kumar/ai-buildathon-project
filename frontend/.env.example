# Frontend Environment Variables for Vercel Deployment

# 1. Primary rewrite proxy target (Vercel Serverless Function rewrites /api/* to this backend URL)
BACKEND_API_URL=https://your-backend-api.onrender.com

# 2. Optional: Direct client browser API URL (if skipping Next.js rewrite proxy)
# NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com

# 3. Environment mode
NODE_ENV=production
